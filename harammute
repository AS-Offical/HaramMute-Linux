#!/usr/bin/env bash
# Public entry point: keep the tray and local server in the same lifecycle.
set -euo pipefail

APP_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
APP_DIR="$(cd "$(dirname "$APP_PATH")" && pwd)"
export HARAMMUTE_VERSION="${HARAMMUTE_VERSION:-1.0.18-linux}"

exec "$APP_DIR/tray_launcher.py" "$@"
